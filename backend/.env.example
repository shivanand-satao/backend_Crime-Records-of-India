PORT=3000

# Exact additional frontend origins, separated by commas. No paths or wildcards.
# Add a trusted Vercel deployment URL here only if it needs authenticated API access.
CORS_ALLOWED_ORIGINS=https://frontend-crime-records-of-india.vercel.app

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=crime_records

JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Full Upstash Redis URL (usually starts with rediss://).
REDIS_URL=rediss://default:your_password@your_upstash_host:6379
GROQ_API_KEY
